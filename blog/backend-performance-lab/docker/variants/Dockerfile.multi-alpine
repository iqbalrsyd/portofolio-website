# docker/variants/Dockerfile.multi-alpine
# Multi-stage build, final image is alpine + ca-certificates + tzdata.
# Common choice for Go services: small, dynamic-linked against musl libc.

FROM golang:1.22 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg/      ./pkg/
COPY services/ ./services/

ARG SERVICE
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags="-s -w" -o /out/app ./services/${SERVICE}

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/app /app
EXPOSE 8080
ENTRYPOINT ["/app"]
