# docker/variants/Dockerfile.distroless-static
# Multi-stage build, final image is gcr.io/distroless/static.
# Truly minimal: no glibc, no busybox, no shell, no package manager.
# Best for static Go binaries; smallest possible image.

FROM golang:1.22 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg/      ./pkg/
COPY services/ ./services/

ARG SERVICE
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN go build -trimpath -ldflags="-s -w -extldflags '-static'" -tags netgo,osusergo \
    -o /out/app ./services/${SERVICE}

FROM gcr.io/distroless/static
COPY --from=build /out/app /app
EXPOSE 8080
ENTRYPOINT ["/app"]
