# docker/variants/Dockerfile.distroless
# Multi-stage build, final image is gcr.io/distroless/base-debian12.
# Includes glibc, ca-certificates, /etc/passwd, no shell, no package manager.
# More secure attack surface, slightly larger than alpine.

FROM golang:1.22 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg/      ./pkg/
COPY services/ ./services/

ARG SERVICE
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags="-s -w" -o /out/app ./services/${SERVICE}

FROM gcr.io/distroless/base-debian12
COPY --from=build /out/app /app
EXPOSE 8080
ENTRYPOINT ["/app"]
