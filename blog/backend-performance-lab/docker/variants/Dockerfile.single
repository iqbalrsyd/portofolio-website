# docker/variants/Dockerfile.single
# Single-stage fat image. Everything (Go toolchain + sources + runtime) in one layer.
# Big size, longest build (no module cache), but simplest to reason about.

FROM golang:1.22

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg/      ./pkg/
COPY services/ ./services/

ARG SERVICE
RUN go build -o /app ./services/${SERVICE}

ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app"]
