# Backend Performance Lab — local environment
# Copy to .env (gitignored) and tweak as needed.

# Postgres
POSTGRES_USER=lab
POSTGRES_PASSWORD=labpass
POSTGRES_DB=labdb
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Service ports (used from Stage 2 onwards)
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# DB URLs consumed by Go services
DATABASE_URL=postgres://lab:labpass@postgres:5432/labdb?sslmode=disable
REDIS_URL=redis://redis:6379/0
